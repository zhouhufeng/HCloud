# HCloud platform contract.
# Copy to hcloud/hcloud.env (git-ignored) on each node, or let the platform layer
# write it. The middleware scripts read ONLY these variables; nothing below names
# a hosting platform. Anything a platform needs beyond this belongs in platform/.

# ---- Kubernetes ------------------------------------------------------------
HCLOUD_K8S_DISTRO=k3s            # k3s (standard) | rke2 (kept for the validated Linux PoC)
HCLOUD_NODE_ROLE=server          # server | agent
HCLOUD_HA=false                  # true on the FIRST server of a 3-server embedded-etcd cluster
HCLOUD_SERVER_URL=               # joiners only: https://<first-server-ip-or-dns>:6443
HCLOUD_TLS_SAN=                  # extra API names/IPs, space separated (e.g. "k3s.hcloud.internal 10.10.50.20")
HCLOUD_K8S_EXTRA_ARGS=           # verbatim distro flags, e.g. "--flannel-iface ens3 --kubelet-arg cloud-provider=external"
# Node token: HCLOUD_K8S_TOKEN env var, else docs/Secretes/k8s-node-token (auto-generated on the first server)

# ---- Storage ---------------------------------------------------------------
HCLOUD_STORAGE_DIR=/var/lib/hcloud/storage   # where the platform mounted the big disk (local-path PVs land here)

# ---- Public serving (leave HCLOUD_DOMAIN empty for a LAN-only cluster) ------
HCLOUD_DOMAIN=                   # e.g. hcloud.genohub.org  → apps at <name>.hcloud.genohub.org
HCLOUD_ACME_EMAIL=               # Let's Encrypt contact
HCLOUD_TUNNEL_NAME=hcloud        # Cloudflare Tunnel name
HCLOUD_INGRESS_SVC_TYPE=LoadBalancer   # LoadBalancer (k3s servicelb / MetalLB / cloud LB) | NodePort
# Cloudflare API token (Zone.DNS:Edit): HCLOUD_CF_API_TOKEN env var, else docs/Secretes/cloudflare-api-token.txt

# ---- Tenants ---------------------------------------------------------------
HCLOUD_USERS=                    # space-separated; each gets a namespace + quota + kubeconfig
HCLOUD_Q_CPU_REQ=4
HCLOUD_Q_MEM_REQ=16Gi
HCLOUD_Q_CPU_LIM=8
HCLOUD_Q_MEM_LIM=32Gi
HCLOUD_Q_PVC_CT=20
HCLOUD_Q_PVC_SZ=500Gi

# ---- Applications ----------------------------------------------------------
HCLOUD_NS=favor-4ee4be           # the NERC project namespace the apps layer migrates
